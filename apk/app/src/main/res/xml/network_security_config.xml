<?xml version="1.0" encoding="utf-8"?>
<!-- Backend může běžet na LAN přes http:// (self-host, Termux), proto povolujeme cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
